# Discord Credentials
DISCORD_APP_ID=your_discord_app_id
DISCORD_PUBLIC_KEY=your_hex_public_key
DISCORD_BOT_TOKEN=your_bot_token
# Optional: Set Discord Server/Guild ID for instant slash command registration during development
DISCORD_GUILD_ID=

# Google GenAI / Vertex AI Configuration
# When running locally, set GEMINI_API_KEY. On GCP Cloud Run with ADC, GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION can be used.
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# GenAI Models & Reasoning Configuration
ORCHESTRATOR_MODEL=gemini-2.0-flash
EXPERT_MODEL=gemini-2.0-flash

# Thinking Configuration (Optional)
# THINKING_BUDGET: Token limit for reasoning (e.g., 0 = off, 1024 = fast, 2048 = standard, 4096 = deep)
# THINKING_LEVEL: Reasoning depth (LOW, MEDIUM, HIGH)
THINKING_BUDGET=
THINKING_LEVEL=

# External APIs (Optional tokens for higher rate limits)
NYC_SOCRATA_APP_TOKEN=
NYPL_API_TOKEN=

# App Configuration
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO
